#!/data/data/com.termux/files/usr/bin/bash
# N2S CLOUD: local visual overlay + protected WebDAV FS PRO + srv.us tunnel.
set -u
PORT=''
OVERLAY=''
PORT_HELPER="$HOME/.local/share/n2s-overlay/n2s-ports.sh"
KEY="$HOME/.ssh/id_ed25519"
PROXY_JS="$HOME/.local/share/n2s-overlay/n2s-overlay.js"
PROXY_PID=""
TUNNEL_PID=""

cleanup() {
  trap - EXIT INT TERM
  if [ -n "$TUNNEL_PID" ]; then
    kill "$TUNNEL_PID" 2>/dev/null || true
    wait "$TUNNEL_PID" 2>/dev/null || true
  fi
  if [ -n "$PROXY_PID" ]; then
    kill "$PROXY_PID" 2>/dev/null || true
    wait "$PROXY_PID" 2>/dev/null || true
  fi
  termux-wake-unlock >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM

if [ ! -s "$KEY" ]; then
  echo 'Nie znaleziono klucza SSH. Najpierw dokończ konfigurację GitHub.'
  exit 1
fi
if [ ! -f "$PROXY_JS" ]; then
  echo "Nie znaleziono nakładki: $PROXY_JS"
  exit 1
fi
# Detect WebDAV FS PRO where it is running now. For example, a running
# WebDAV on 8080 makes N2S use 8081 automatically, with no app changes.
if [ ! -f "$PORT_HELPER" ]; then
  echo "Brak pliku konfiguracji portow: $PORT_HELPER"
  echo 'Uruchom najnowszy instalator N2S CLOUD.'
  exit 1
fi
. "$PORT_HELPER"
if ! choose_n2s_ports 8080 8081; then
  exit 1
fi
echo "Wykryto WebDAV FS PRO na porcie $PORT (haslo wymagane)."
echo "Uruchamiam N2S CLOUD na wolnym porcie $OVERLAY."

termux-wake-lock >/dev/null 2>&1 || true
N2S_UPSTREAM_PORT="$PORT" N2S_PROXY_PORT="$OVERLAY" node "$PROXY_JS" &
PROXY_PID=$!
sleep 1
if ! kill -0 "$PROXY_PID" 2>/dev/null ||
   [ "$(curl -s --max-time 2 "http://127.0.0.1:$OVERLAY/_n2s_overlay_2026/health")" != 'N2S OK' ]; then
  echo 'Nakładka nie uruchomiła się. Sprawdź, czy port $OVERLAY jest wolny.'
  exit 1
fi


echo 'N2S CLOUD — nakładka gotowa.'
echo "WebDAV: 127.0.0.1:$PORT | N2S CLOUD: 127.0.0.1:$OVERLAY"
echo "Widok lokalny: http://127.0.0.1:$OVERLAY/n2s_cloude"
echo 'Publiczny adres: https://jargielo.gh.srv.us/n2s_cloude'
echo 'Zatrzymanie: CTRL+C'
echo 'Odnowienie tunelu: co 60 minut.'

while true; do
  if ! n2s_has_auth "$PORT"; then
    echo 'Oczekuję na serwer z aktywnym hasłem (15 s)...'
    sleep 15
    continue
  fi
  echo 'Hasło zweryfikowane (HTTP 401). Łączę tunel z nakładką...'
  ssh -T -i "$KEY" \
    -o IdentitiesOnly=yes -o BatchMode=yes \
    -o StrictHostKeyChecking=accept-new \
    -o ConnectTimeout=15 -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes \
    -R "1:127.0.0.1:$OVERLAY" jargielo@srv.us &
  TUNNEL_PID=$!
  STARTED_AT=$SECONDS
  # If another Termux session tunnels directly to WebDAV, the old
  # interface will respond with 404 on /n2s_cloude. Report this explicitly.
  sleep 3
  PUBLIC_HEALTH="$(curl -fsS --connect-timeout 4 --max-time 8 \
    'https://jargielo.gh.srv.us/_n2s_overlay_2026/health' 2>/dev/null || true)"
  if [ "$PUBLIC_HEALTH" != 'N2S OK' ]; then
    echo 'UWAGA: Publiczny adres NIE wskazuje na nakladke N2S.'
    echo 'Mozliwy drugi tunel do WebDAV lub nieaktywne mapowanie srv.us.'
    echo 'Zatrzymaj stary serwer/ssh -R w innej sesji Termuxa.'
    echo "Lokalna nakladka: http://127.0.0.1:$OVERLAY/n2s_cloude"
  else
    echo 'OK: Publiczny tunel kieruje do N2S CLOUD.'
    # Probe the actual browser landing route, not only the health endpoint.
    PUBLIC_REDIRECT="$(curl -sS -o /dev/null -D - --connect-timeout 4 --max-time 8 \
      -H 'Accept: text/html' 'https://jargielo.gh.srv.us/' 2>/dev/null \
      | tr -d '\r' | grep -i '^location:' | tail -n 1 | sed -E 's/^[Ll]ocation:[[:space:]]*//' || true)"
    if [ "$PUBLIC_REDIRECT" != '/n2s_cloude#' ]; then
      echo "UWAGA: Strona glowna nie przekierowuje prawidlowo (Location: ${PUBLIC_REDIRECT:-brak})."
      echo 'Sprawdz, czy nie dziala starsza nakladka lub drugi tunel.'
    else
      echo 'OK: Adres glowny kieruje do /n2s_cloude.'
    fi
    echo 'Otworz: https://jargielo.gh.srv.us/n2s_cloude'
  fi
  while kill -0 "$TUNNEL_PID" 2>/dev/null; do
    sleep 15
    if [ $((SECONDS - STARTED_AT)) -ge 3600 ]; then
      echo 'Minęło 60 minut. Odnawiam tunel...'
      kill "$TUNNEL_PID" 2>/dev/null || true
      break
    fi
    if ! n2s_has_auth "$PORT"; then
      echo 'Zatrzymuję tunel: ochrona hasłem jest niedostępna.'
      kill "$TUNNEL_PID" 2>/dev/null || true
      break
    fi
  done
  wait "$TUNNEL_PID" 2>/dev/null || true
  TUNNEL_PID=""
  echo 'Ponawiam połączenie za 5 sekund...'
  sleep 5
done
